# Local development: copy into your shell's environment; Floatwise does not
# automatically load dotenv files. Never commit real values or bank tokens.
FLOATWISE_AUTH_MODE=demo
FLOATWISE_DEMO=1
FLOATWISE_ALLOW_SIGNUP=1
FLOATWISE_COOKIE_SECURE=0
FLOATWISE_AUTH_DB_PATH=data/accounts.sqlite3
FLOATWISE_DEMO_DB_PATH=data/demo.sqlite3
FLOATWISE_WORKSPACE_ROOT=data/workspaces

# Live bank connector is OPTIONAL. Without these, use statement imports.
# Never use real banking credentials on a disposable demo deployment.
PLAID_ENV=sandbox
PLAID_COUNTRIES=US
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=
# Optional OAuth redirect URI registered with Plaid:
PLAID_REDIRECT_URI=
